<?xml version="1.0" encoding="utf-8"?>
<!--
  Сервер «Ищейки» разворачивается во внутренней сети и обычно работает
  по http без сертификата. Открытый трафик разрешён только для частных
  диапазонов и localhost - наружу приложение по http не ходит.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.0.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
        <domain includeSubdomains="true">172.16.0.0</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.100.20.222</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
